# Quarto generated files and directories
.quarto/
_freeze/
_site/
docs/ # If using GitHub Pages with a 'docs' directory
output/ # Common output directory name
*.html
*.pdf
*.docx
*.epub
*.ipynb # If rendering .qmd to .ipynb and not tracking the output
*.md # If rendering .qmd to .md and not tracking the output

# R-specific files (if using R with Quarto)
.Rproj.user/
.Rhistory
.Rdata
.Rprofile
.env
renv/
renv.lock

# Python-specific files (if using Python with Quarto)
__pycache__/
.venv/
venv/
*.pyc

# Editor/OS specific files
.DS_Store
Thumbs.db
/.quarto/
